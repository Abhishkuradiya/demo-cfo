      "roundness": null,
      "seed": 1629455318,
      "version": 100,
      "versionNonce": 1399982934,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786525914571,
      "link": null,
      "locked": false,
      "text": "It registers the 16 Tools by converting their TypeScript inputs schemas to the\nstandard OpenAPI-compatible parameters schema required by Gemini.",
