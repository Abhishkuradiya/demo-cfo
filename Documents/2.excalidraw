    {
      "id": "NuWv5sYDbTE1wIlfSh24t",
      "type": "text",
      "x": 32.44916110568579,
      "y": 842.7222222222224,
      "width": 796.8794555664062,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
