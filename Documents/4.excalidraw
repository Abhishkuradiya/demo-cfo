      "isDeleted": true,
      "boundElements": null,
      "updated": 1786526453178,
      "link": null,
      "locked": false,
      "text": "Function Calling (Tools Needed): If the user asks a financial query (e.g., \"Who has the highest cash\nbalance?\"), Gemini returns one or more functionCall objects in the JSON payload rather than direct\ntext.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Function Calling (Tools Needed): If the user asks a financial query (e.g., \"Who has the highest cash balance?\"), Gemini returns one or more functionCall objects in the JSON payload rather than direct text.",
      "autoResize": false,
      "lineHeight": 1.25
    },
